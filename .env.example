# Application Settings
PROJECT_NAME="Mirage IDE"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="mirage_super_secret_jwt_key_dev_mode_only_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL)
POSTGRES_USER=mirage_user
POSTGRES_PASSWORD=mirage_password
POSTGRES_DB=mirage_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://mirage_user:mirage_password@localhost:5432/mirage_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage Settings (Local Disk Storage or AWS S3)
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=mirage-ide-projects-bucket

# Code Execution Limits
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MAX_MEMORY=128m
EXECUTION_MAX_CPU=0.5
EXECUTION_MAX_OUTPUT_BYTES=65536

# Microservice Endpoints (Local Development Defaults)
API_GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
FILE_SERVICE_URL=http://localhost:8003
IMPORT_SERVICE_URL=http://localhost:8004
EXECUTION_SERVICE_URL=http://localhost:8005
TERMINAL_SERVICE_URL=http://localhost:8006
COLLABORATION_SERVICE_URL=http://localhost:8007
COLLABORATION_SERVICE_WS_URL=ws://localhost:8007
CHAT_SERVICE_URL=http://localhost:8008
CHAT_SERVICE_WS_URL=ws://localhost:8008
HISTORY_SERVICE_URL=http://localhost:8009

# CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

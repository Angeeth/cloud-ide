# Application Settings
PROJECT_NAME="Mirage IDE"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
POSTGRES_USER=mirage_user
POSTGRES_PASSWORD=mirage_password
POSTGRES_DB=mirage_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mirage_user:mirage_password@localhost:5432/mirage_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AWS S3 Settings (Optional for local disk fallback)
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=mirage-ide-projects-bucket
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./storage

# Docker Execution Limits
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MAX_MEMORY=128m
EXECUTION_MAX_CPU=0.5
EXECUTION_MAX_OUTPUT_BYTES=65536

# CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
